# PostgreSQL 17 on a single-AZ db.t4g.micro, in the private database subnets, not publicly accessible.
#
# SECRETS AND TERRAFORM STATE
# The master password is generated by an EPHEMERAL resource and handed to RDS and Secrets Manager
# through WRITE-ONLY arguments (password_wo, secret_string_wo). Terraform never stores ephemeral
# or write-only values in state or plan files; only the *_version numbers are stored. To rotate,
# increase var.db_password_version: both the database and the secret are updated in one apply.
#
# The state still contains non-secret but sensitive details (hostnames, ARNs, security group IDs),
# which is why the state bucket is private, encrypted and TLS-only.

ephemeral "random_password" "db_master" {
  length = 32
  # Avoid characters that need escaping in a connection string (; = ' " \ and spaces).
  special          = true
  override_special = "!#%*()-_+[]{}<>:?"
}

resource "aws_db_subnet_group" "main" {
  name       = local.name_prefix
  subnet_ids = aws_subnet.database[*].id
}

resource "aws_db_instance" "estimates" {
  identifier     = "${local.name_prefix}-estimates"
  engine         = "postgres"
  engine_version = "17" # major version; RDS applies minor upgrades (auto_minor_version_upgrade)

  instance_class        = var.db_instance_class
  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = 0 # no storage autoscaling: keeps cost predictable
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name             = "estimates"
  username            = "estimates_admin"
  password_wo         = ephemeral.random_password.db_master.result
  password_wo_version = var.db_password_version

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  publicly_accessible    = false
  multi_az               = false
  port                   = 5432

  backup_retention_period    = 1
  auto_minor_version_upgrade = true
  apply_immediately          = true
  deletion_protection        = false

  # Destroy behaviour: by default a final snapshot is kept (it costs storage until you delete it).
  skip_final_snapshot       = var.db_skip_final_snapshot
  final_snapshot_identifier = var.db_skip_final_snapshot ? null : "${local.name_prefix}-estimates-final"

  performance_insights_enabled = false
  copy_tags_to_snapshot        = true
}

# The API reads one value: ConnectionStrings__EstimatesDb, injected by ECS from the
# "connectionString" key of this secret. SSL is required (RDS PostgreSQL enforces it by default).
resource "aws_secretsmanager_secret" "estimates_db" {
  name        = "${var.project}/${var.environment}/estimates-db"
  description = "Connection details for the ${local.name_prefix} Estimates database."

  # Dev only: delete immediately on destroy so the name can be reused at once.
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "estimates_db" {
  secret_id = aws_secretsmanager_secret.estimates_db.id
  secret_string_wo = jsonencode({
    username = aws_db_instance.estimates.username
    password = ephemeral.random_password.db_master.result
    host     = aws_db_instance.estimates.address
    port     = aws_db_instance.estimates.port
    dbname   = aws_db_instance.estimates.db_name
    connectionString = join(";", [
      "Host=${aws_db_instance.estimates.address}",
      "Port=${aws_db_instance.estimates.port}",
      "Database=${aws_db_instance.estimates.db_name}",
      "Username=${aws_db_instance.estimates.username}",
      "Password=${ephemeral.random_password.db_master.result}",
      "SSL Mode=Require",
      "GSS Encryption Mode=Disable",
    ])
  })
  secret_string_wo_version = var.db_password_version
}
