# LOCAL DEVELOPMENT ONLY. Copy to .env (which is gitignored) or, better, run:
#   PowerShell:  ./scripts/init-dev-env.ps1
#   bash:        ./scripts/init-dev-env.sh
# The scripts generate random values and also store them as .NET user secrets for `dotnet run`.
# Never commit .env. Production secrets belong in a secret store (see docs/deployment.md).

POSTGRES_PASSWORD=
ESTIMATES_DB_PASSWORD=
ACCOUNTING_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
ACCOUNTING_SERVICE_CLIENT_SECRET=

# Optional host port overrides (defaults 55432 and 8180). If you change KEYCLOAK_HOST_PORT, also
# update the localhost:8180 URLs in src/*/*.Api/appsettings.Development.json and scripts/get-token.*.
# POSTGRES_HOST_PORT=55432
# KEYCLOAK_HOST_PORT=8180
