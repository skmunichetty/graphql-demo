{
  "realm": "construction",
  "displayName": "Construction Estimation (LOCAL DEMO)",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant (admin only)\",\"validations\":{\"length\":{\"min\":1,\"max\":64}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"unmanagedAttributePolicy\":\"ADMIN_VIEW\"}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject (sub) and auth_time claims.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tenant",
      "description": "Adds the user's tenant_id attribute as the tenant_id claim.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "estimates:read",
      "description": "Read estimates in your tenant.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "audience estimates-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "estimates-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "estimates:write",
      "description": "Create, change and approve estimates in your tenant.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "audience estimates-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "estimates-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "estimates:integration.read",
      "description": "Service-to-service: read an estimate for a named tenant. Accounting service only.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience estimates-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "estimates-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "accounting:export",
      "description": "Export approved estimates to accounting.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "audience accounting-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "accounting-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "accounting:read",
      "description": "Read accounting export status.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "audience accounting-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "accounting-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [ "basic" ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "construction-dev-cli",
      "name": "Local development client (DEMO ONLY)",
      "description": "Public client for obtaining developer tokens. Direct access grants (password grant) are enabled for local convenience only and must never be enabled in production.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [ "http://localhost:5173/*" ],
      "webOrigins": [ "http://localhost:5173" ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": [ "basic", "tenant" ],
      "optionalClientScopes": [ "estimates:read", "estimates:write", "accounting:export", "accounting:read" ]
    },
    {
      "clientId": "accounting-service",
      "name": "Accounting Integration Service (service identity)",
      "description": "Confidential client used by the Accounting service to call the Estimates API. Least privilege: only estimates:integration.read.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ACCOUNTING_SERVICE_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "defaultClientScopes": [ "basic" ],
      "optionalClientScopes": [ "estimates:integration.read" ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@acme-builders.example",
      "firstName": "Alice",
      "lastName": "Acme",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant_id": [ "tenant-acme" ] },
      "credentials": [ { "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false } ]
    },
    {
      "username": "bob",
      "email": "bob@bayside-renovations.example",
      "firstName": "Bob",
      "lastName": "Bayside",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant_id": [ "tenant-bayside" ] },
      "credentials": [ { "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false } ]
    },
    {
      "username": "service-account-accounting-service",
      "enabled": true,
      "serviceAccountClientId": "accounting-service"
    }
  ]
}
