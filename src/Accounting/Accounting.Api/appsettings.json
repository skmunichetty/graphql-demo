{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "accounting-api",
    "RequireHttpsMetadata": true,
    "TenantClaimType": "tenant_id"
  },
  "EstimatesService": {
    "BaseAddress": "",
    "TokenEndpoint": "",
    "ClientId": "accounting-service",
    "ClientSecret": "",
    "Scope": "estimates:integration.read",
    "AttemptTimeoutSeconds": 3,
    "TotalTimeoutSeconds": 10,
    "MaxRetryAttempts": 2
  },
  "Export": {
    "ProviderTimeoutSeconds": 15,
    "PendingTimeoutSeconds": 120
  },
  "MockAccountingProvider": {
    "SimulatedLatencyMilliseconds": 150
  },
  "GraphQL": {
    "EnableDeveloperTools": false,
    "EnableIntrospection": false,
    "IncludeExceptionDetails": false,
    "MaxExecutionDepth": 8,
    "ExecutionTimeoutSeconds": 30,
    "MaxFieldCost": 1000,
    "MaxTypeCost": 5000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 50,
    "WindowSeconds": 10
  },
  "Hosting": {
    "EnforceHttps": true,
    "ApplyMigrationsOnStartup": false
  }
}
