{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "estimates-api",
    "RequireHttpsMetadata": true,
    "TenantClaimType": "tenant_id"
  },
  "GraphQL": {
    "EnableDeveloperTools": false,
    "EnableIntrospection": false,
    "IncludeExceptionDetails": false,
    "MaxExecutionDepth": 8,
    "ExecutionTimeoutSeconds": 10,
    "MaxFieldCost": 1000,
    "MaxTypeCost": 5000
  },
  "Pricing": {
    "DefaultTaxRatePercent": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "Hosting": {
    "EnforceHttps": true,
    "ApplyMigrationsOnStartup": false
  }
}
